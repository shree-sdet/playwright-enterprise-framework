{
  "name": "playwright-enterprise-framework",
  "version": "1.0.0",
  "description": "Enterprise-grade Playwright + TypeScript automation framework",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test tests/ui",
    "test:api": "playwright test tests/api",
    "test:a11y": "playwright test tests/accessibility",
    "test:mobile": "playwright test --project='Mobile Chrome' --project='Mobile Safari'",
    "test:visual": "playwright test --project=visual-chromium",
    "clean:allure": "rm -rf allure-results allure-report",
    "copy:allure-config": "cp config/allure/* allure-results/",
    "test:allure": "npm run clean:allure && playwright test && npm run copy:allure-config && allure generate allure-results --clean"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@pact-foundation/pact": "^16.4.0",
    "@playwright/test": "^1.60.0",
    "@types/express": "^4.17.21",
    "@types/node": "^25.8.0",
    "@types/pg": "^8.20.0",
    "allure-js-commons": "^3.9.0",
    "allure-playwright": "^3.9.0",
    "browserstack-node-sdk": "^1.55.5",
    "dotenv-cli": "^11.0.0"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "prom-client": "^15.1.3",
    "pg": "^8.21.0"
  },
  "overrides": {
    "https-proxy-agent": "5.0.1"
  }
}
